# Shop API Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Configuration
POSTGRES_URL=jdbc:postgresql://your-host:5432/shopapi?sslmode=require
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shopapi?retryWrites=true&w=majority

# Redis Configuration
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# Server Configuration
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_secret_key_at_least_256_bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Admin Configuration (Auto-created on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecureAdminPassword123!
ADMIN_EMAIL=admin@yourdomain.com

# Cloudinary Configuration (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=shopapi/products

# Mailjet Configuration (Email Service)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_API_SECRET=your_mailjet_api_secret
MAILJET_SENDER_EMAIL=noreply@yourdomain.com
MAILJET_SENDER_NAME=Shop API

# Razorpay Configuration (Payment Gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=Your Company Name
RAZORPAY_SUCCESS_URL=http://localhost:3000/payment/success
RAZORPAY_CANCEL_URL=http://localhost:3000/payment/cancel

# Application URLs
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

